---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "t0code — a workspace for coding agents",
  description = "Work with coding agents in your real project, with conversations, diffs, terminals, and approvals together.",
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:site_name" content="t0code" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#111310" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-16x16.png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
  </head>
  <body>
    <div class="page">
      <nav class="nav" aria-label="Main navigation">
        <a href="/" class="nav-brand" aria-label="t0code home">
          <img src="/brand-mark.svg" alt="" class="nav-icon" />
          <span>t0code</span>
        </a>
        <div class="nav-links">
          <a href="/download" class="nav-link">Download</a>
          <a href="https://github.com/codealisha99/t0code" target="_blank" rel="noopener noreferrer" class="nav-github">
            GitHub <span aria-hidden="true">&#8599;</span>
          </a>
        </div>
      </nav>

      <main class="main"><slot /></main>

      <footer class="footer">
        <span class="footer-copy">t0code is maintained by <a href="https://alishakarma.com">Alisha Karma</a>.</span>
        <div class="footer-links" aria-label="Creator and project links">
          <a href="https://github.com/codealisha99/t0code" target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href="https://x.com/karmalisha" target="_blank" rel="noopener noreferrer">X</a>
          <a href="mailto:lishykarma99@gmail.com">Contact</a>
        </div>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --bg: #111310;
    --surface: #191c18;
    --fg: #f1f2eb;
    --fg-muted: #bec4b6;
    --fg-dim: #92998a;
    --accent: #c5e478;
    --accent-hover: #d5f08e;
    --accent-foreground: #18200e;
    --border: #30352d;
    --border-hover: #525a49;
    --surface-hover: #20241e;
    --gutter: clamp(1.25rem, 5vw, 5rem);
    --content-width: 1160px;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body {
    min-height: 100vh;
    overflow-x: hidden;
    background: var(--bg);
    color: var(--fg);
    font-family: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
  a { color: inherit; text-decoration: none; }
  img { display: block; max-width: 100%; }
  a:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; transition-duration: .01ms !important; }
  }
</style>

<style>
  .page { min-height: 100vh; display: flex; flex-direction: column; }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 68px;
    padding: 1rem var(--gutter);
    border-bottom: 1px solid var(--border);
  }
  .nav-brand { display: flex; align-items: center; gap: .7rem; font-weight: 650; letter-spacing: -.03em; }
  .nav-icon { width: 30px; height: 30px; border-radius: 8px; }
  .nav-links, .footer-links { display: flex; align-items: center; gap: 1.5rem; }
  .nav-link, .nav-github { color: var(--fg-muted); font-size: .875rem; transition: color .18s ease; }
  .nav-github { display: flex; align-items: center; gap: .35rem; }
  .nav-github span { color: var(--accent); }
  .nav-link:hover, .nav-github:hover, .footer a:hover { color: var(--fg); }
  .main { flex: 1; display: flex; flex-direction: column; align-items: center; }
  .footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.35rem var(--gutter);
    border-top: 1px solid var(--border);
    color: var(--fg-dim);
    font-size: .8rem;
  }
  .footer-copy a { color: var(--fg-muted); }
  .footer-links { gap: 1.25rem; }
  .footer-links a { color: var(--fg-dim); transition: color .18s ease; }
  @media (max-width: 640px) {
    .nav { min-height: 60px; }
    .nav-links { gap: 1rem; }
    .footer { align-items: flex-start; flex-direction: column; padding-block: 1.25rem; }
    .footer-links { flex-wrap: wrap; gap: 1rem; }
  }
</style>
